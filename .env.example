# PostgreSQL
POSTGRES_DB=liqi
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-superuser

# Role passwords (dùng bởi infra/postgres/init)
LIQI_OWNER_PASSWORD=change-me-owner
LIQI_WORKER_PASSWORD=change-me-worker
LIQI_API_PASSWORD=change-me-api

# Connection strings (host "postgres" khi chạy trong Compose; "localhost" khi dev ngoài Docker)
MIGRATION_DATABASE_URL=postgresql+psycopg://liqi_owner:change-me-owner@postgres:5432/liqi
WORKER_DATABASE_URL=postgresql+psycopg://liqi_worker:change-me-worker@postgres:5432/liqi
API_DATABASE_URL=postgresql://liqi_api:change-me-api@postgres:5432/liqi

# Fandom
FANDOM_API_URL=https://arenaofvalor.fandom.com/api.php
FANDOM_USER_AGENT=LiqiWikiBot/0.1 (contact: you@example.com)
FANDOM_REQUESTS_PER_SECOND=1

# Raw storage
RAW_STORAGE_PATH=/data/raw

# Web → NestJS (server-side)
INTERNAL_API_URL=http://api:3001
